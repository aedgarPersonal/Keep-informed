# Supabase project — get values from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — server-only. Used for the AI medication review feature.
# Without this, the review page renders a placeholder telling the
# caregiver the feature is unavailable; the rest of the app still works.
ANTHROPIC_API_KEY=
